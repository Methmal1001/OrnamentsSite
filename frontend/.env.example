# Base URL of the ASP.NET Core Web API (must be https:// in deployed environments)
NUXT_PUBLIC_API_BASE_URL=http://localhost:5196/api
# false = real API (default), true = offline demo with local dummy data
NUXT_PUBLIC_USE_MOCK_API=false
# Show "Customer demo / Admin demo" shortcuts on the login page. Development only, never in production.
NUXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
